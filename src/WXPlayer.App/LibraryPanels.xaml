<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LiveTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="LibraryCategoryBackground" Color="#0C0F11"/>
  <SolidColorBrush x:Key="LibraryGroupInk" Color="#69726F"/>
  <SolidColorBrush x:Key="LibraryCategorySelected" Color="#1CC5F27A"/>
  <SolidColorBrush x:Key="LibraryPosterInk" Color="#55605D"/>
  <SolidColorBrush x:Key="LibraryPosterLine" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="LibraryTagInk" Color="#B9C2BE"/>
  <SolidColorBrush x:Key="LibraryBackGlass" Color="#990E1114"/>
  <ui:LibraryTextConverter x:Key="LibraryText"/>
  <ui:LibraryPlayingConverter x:Key="LibraryPlaying"/>
  <ui:LibraryGroupHeaderConverter x:Key="LibraryGroupHeader"/>
  <Style x:Key="LibraryOptionalText" TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="LibraryCategoryRow" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Background="Transparent" CornerRadius="12.8"><Grid><Border x:Name="Mark" Background="{StaticResource LiveAccent}" Width="3" VerticalAlignment="Bottom" Height="20.8" Margin="0,0,0,11.2" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveRaised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LibraryCategorySelected}"/><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Setter Property="Foreground" Value="{StaticResource LiveCaption}"/>
  </Style>
  <DataTemplate x:Key="LibraryCategoryTemplate"><StackPanel>
    <TextBlock Foreground="{StaticResource LibraryGroupInk}" FontSize="10.24" FontWeight="ExtraBold" Margin="11.2,16,11.2,6.4" Style="{StaticResource LibraryOptionalText}"><TextBlock.Text><MultiBinding Converter="{StaticResource LibraryGroupHeader}"><Binding/><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></TextBlock.Text></TextBlock>
    <Border Height="43.2" Padding="12,0"><TextBlock Text="{Binding Converter={StaticResource LibraryText},ConverterParameter=Category}" ToolTip="{Binding}" FontSize="14.4" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Left"/></Border>
  </StackPanel></DataTemplate>
  <Style x:Key="LibraryMovieRow" TargetType="ListBoxItem" BasedOn="{StaticResource LiveChannelRow}"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="68.8"/><Setter Property="Padding" Value="8,6.4,9.6,6.4"/></Style>
  <Style x:Key="LibraryInfoCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="19.2"/><Setter Property="Padding" Value="19.2,16"/></Style>
  <Style x:Key="LibraryTag" TargetType="Border"><Setter Property="Background" Value="{StaticResource LiveRaised}"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10.4,4"/><Setter Property="Margin" Value="0,0,6.4,0"/></Style>
  <Style x:Key="LibraryInfoButton" TargetType="Button" BasedOn="{StaticResource LiveButton}"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="17.6,0"/><Setter Property="Background" Value="{StaticResource LiveButtonHover}"/><Setter Property="FontSize" Value="13.44"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="LibraryBackButton" TargetType="Button" BasedOn="{StaticResource LiveButton}"><Setter Property="Background" Value="{StaticResource LibraryBackGlass}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7.2,5.6,12.8,5.6"/><Setter Property="FontSize" Value="12.48"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="LibraryVolumeReveal" TargetType="Border"><Setter Property="Width" Value="0"/><Setter Property="Opacity" Value="0"/><Setter Property="ClipToBounds" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True"><Setter Property="Width" Value="88"/><Setter Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Width" Value="88"/><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
