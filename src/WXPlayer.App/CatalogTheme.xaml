<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <!-- wx-player-filmler-diziler.html. These CSS names are deliberately local to CatalogView. -->
  <SolidColorBrush x:Key="--bg" Color="#0A0C0E" />
  <SolidColorBrush x:Key="--p1" Color="#101417" />
  <SolidColorBrush x:Key="--p2" Color="#171C20" />
  <SolidColorBrush x:Key="--p3" Color="#1F262B" />
  <SolidColorBrush x:Key="--ink" Color="#F2F5EE" />
  <SolidColorBrush x:Key="--mut" Color="#8F9996" />
  <SolidColorBrush x:Key="--acc" Color="#C5F27A" />
  <SolidColorBrush x:Key="--line" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="CatalogDarkInk" Color="#0C0F10" />
  <SolidColorBrush x:Key="CatalogAccentInk" Color="#10160A" />
  <SolidColorBrush x:Key="CatalogHeaderGlass" Color="#D10A0C0E" />
  <SolidColorBrush x:Key="CatalogArrowGlass" Color="#D90A0C0E" />
  <SolidColorBrush x:Key="CatalogStarGlass" Color="#8C0A0C0E" />
  <SolidColorBrush x:Key="CatalogButtonGlass" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="CatalogButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="CatalogMetadata" Color="#C3CBC7" />
  <FontFamily x:Key="CatalogFont">pack://application:,,,/WXPlayer;component/Assets/Fonts/#Manrope</FontFamily>
  <ui:CatalogFavoriteIcon x:Key="CatalogFavoriteIcon"/>
  <Style x:Key="CatalogFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource --acc}" BorderThickness="2" CornerRadius="9.6" Margin="-4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource CatalogFont}" />
    <Setter Property="FontSize" Value="14.08" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource --ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource CatalogFocus}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ui:CatalogPillBorder Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ui:CatalogPillBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource --p2}" />
              <Setter Property="Foreground" Value="{StaticResource --ink}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogChip" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontSize" Value="13.6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource --mut}" />
    <Setter Property="Background" Value="{StaticResource --p2}" />
  </Style>
  <Style x:Key="CatalogSelectedChip" TargetType="Button" BasedOn="{StaticResource CatalogChip}">
    <Setter Property="Background" Value="{StaticResource --ink}" />
    <Setter Property="Foreground" Value="{StaticResource CatalogDarkInk}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ui:CatalogPillBorder Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="999">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ui:CatalogPillBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogPrimary" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="Background" Value="{StaticResource --ink}" />
    <Setter Property="Foreground" Value="{StaticResource CatalogDarkInk}" />
    <Setter Property="Height" Value="46.4" />
    <Setter Property="Padding" Value="22.4,0" />
    <Setter Property="FontSize" Value="14.72" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ui:CatalogPillBorder Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ui:CatalogPillBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.82" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogAddSource" TargetType="Button" BasedOn="{StaticResource CatalogPrimary}">
    <Setter Property="Background" Value="{StaticResource --acc}" />
    <Setter Property="Foreground" Value="{StaticResource CatalogAccentInk}" />
    <Setter Property="Height" Value="41.6" />
    <Setter Property="Padding" Value="17.6,0" />
    <Setter Property="FontSize" Value="14.08" />
  </Style>
  <Style x:Key="CatalogIconButton" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="ui:CatalogPillBorder.TransitionSeconds" Value="0.15"/>
    <Setter Property="Width" Value="41.6" />
    <Setter Property="Height" Value="41.6" />
    <Setter Property="Foreground" Value="{StaticResource --mut}" />
  </Style>
  <Style x:Key="CatalogCardButton" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogFavorite" TargetType="Button" BasedOn="{StaticResource CatalogIconButton}">
    <Setter Property="ui:CatalogPillBorder.TransitionSeconds" Value="0.2"/>
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{StaticResource CatalogStarGlass}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFavorite}" Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource --acc}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CatalogSearch" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource CatalogFont}" />
    <Setter Property="FontSize" Value="14.4" />
    <Setter Property="Foreground" Value="{StaticResource --ink}" />
    <Setter Property="CaretBrush" Value="{StaticResource --ink}" />
    <Setter Property="Background" Value="{StaticResource --p2}" />
    <Setter Property="BorderBrush" Value="{StaticResource --line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="41.6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="44.8,0,48,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource CatalogFocus}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ui:CatalogPillBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
          </ui:CatalogPillBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CatalogSource" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource CatalogFont}" />
    <Setter Property="FontSize" Value="13.6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource --ink}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="41.6" />
    <Setter Property="Width" Value="172" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="DropToggle" Foreground="{StaticResource --ink}" FontFamily="{StaticResource CatalogFont}" FontSize="13.6" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <ui:CatalogPillBorder Background="{StaticResource --p2}" BorderBrush="{StaticResource --line}" BorderThickness="1" CornerRadius="999">
                    <Grid Margin="16,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Fill="{StaticResource --acc}" Width="8" Height="8" />
                      <ContentPresenter Grid.Column="1" Margin="8,0,0,0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" />
                    </Grid>
                  </ui:CatalogPillBorder>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="{StaticResource --p2}" BorderBrush="{StaticResource --line}" BorderThickness="1" CornerRadius="9.6" Padding="8" MinWidth="172">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource CatalogFocus}" />
  </Style>
  <Style x:Key="CatalogViewport" TargetType="ScrollViewer">
    <Setter Property="Background" Value="{StaticResource --bg}" />
    <Setter Property="FontFamily" Value="{StaticResource CatalogFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource --ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{TemplateBinding Tag}" Grid.ColumnSpan="2" />
            <ScrollContentPresenter Grid.Row="1" x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar Grid.Row="1" Grid.Column="1" x:Name="PART_VerticalScrollBar" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Width="6" />
            <ContentPresenter Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding ResumeControl, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="25.6,0,25.6,22.4" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
