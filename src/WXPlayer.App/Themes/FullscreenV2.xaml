<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <!-- All rem dimensions are expressed at 16px here; the fullscreen root applies
       clamp(14px, .62vw + 8px, 22px) / 16. Only fullscreen uses these styles. -->
  <SolidColorBrush x:Key="FsHover" Color="#29FFFFFF"/>
  <SolidColorBrush x:Key="FsActive" Color="#2EC5F27A"/>
  <SolidColorBrush x:Key="FsRowHover" Color="#17FFFFFF"/>
  <SolidColorBrush x:Key="FsRowActive" Color="#21C5F27A"/>
  <ControlTemplate x:Key="FullscreenEqualizerTemplate" TargetType="Control">
    <StackPanel Orientation="Horizontal" Height="14.4" VerticalAlignment="Center">
      <Border x:Name="A" Width="3" Height="4.32" Background="{StaticResource --acc}" CornerRadius="1" VerticalAlignment="Bottom"/>
      <Border x:Name="B" Width="3" Height="4.32" Margin="2,0,0,0" Background="{StaticResource --acc}" CornerRadius="1" VerticalAlignment="Bottom"/>
      <Border x:Name="C" Width="3" Height="4.32" Margin="2,0,0,0" Background="{StaticResource --acc}" CornerRadius="1" VerticalAlignment="Bottom"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsVisible" Value="True"><Trigger.EnterActions><BeginStoryboard x:Name="EqualizerAnimation"><Storyboard>
      <DoubleAnimation Storyboard.TargetName="A" Storyboard.TargetProperty="Height" From="4.32" To="14.4" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="Height" From="4.32" To="14.4" BeginTime="0:0:0.2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="C" Storyboard.TargetProperty="Height" From="4.32" To="14.4" BeginTime="0:0:0.4" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
    </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><StopStoryboard BeginStoryboardName="EqualizerAnimation"/></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="FullscreenToolTip" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource FullscreenFont}"/><Setter Property="FontSize" Value="12.48"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource --ink}"/><Setter Property="Padding" Value="11.2,6.4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="#DD000000" CornerRadius="9.6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FsFocus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource --acc}" BorderThickness="2" CornerRadius="14.4" Margin="-4"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenIconButton" TargetType="Button">
    <Setter Property="Width" Value="44.8"/><Setter Property="Height" Value="44.8"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource FullscreenFont}"/><Setter Property="Foreground" Value="{StaticResource --ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FsFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" CornerRadius="14.4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
        <Grid><Border Background="{TemplateBinding Background}" CornerRadius="14.4"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#29FFFFFF" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenBackButton" TargetType="Button" BasedOn="{StaticResource FullscreenIconButton}">
    <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Background" Value="#8C0C0F11"/><Setter Property="BorderBrush" Value="{StaticResource --line}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/><Ellipse x:Name="Hover" Fill="White" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.16"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenPlayButton" TargetType="Button" BasedOn="{StaticResource FullscreenIconButton}">
    <Setter Property="Width" Value="59.2"/><Setter Property="Height" Value="59.2"/><Setter Property="Background" Value="{StaticResource --acc}"/><Setter Property="Foreground" Value="#10160A"/><Setter Property="RenderTransformOrigin" Value=".5,.5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="PlaySurface" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform><Ellipse Fill="{TemplateBinding Background}"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="PlaySurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></EventTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenTabButton" TargetType="Button" BasedOn="{StaticResource FullscreenIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="3.2,7.2"/><Setter Property="FontSize" Value="12.8"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource --mut}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10.4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenMenuButton" TargetType="Button" BasedOn="{StaticResource FullscreenIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="11.2,8.8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="14.4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="9.6"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1AFFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenChipButton" TargetType="Button" BasedOn="{StaticResource FullscreenIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="17.6,11.2"/><Setter Property="Background" Value="#F2F4F7F1"/><Setter Property="Foreground" Value="#10160A"/><Setter Property="FontSize" Value="14.4"/><Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="14.4"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.4"/></Border.Effect><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenSearch" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FullscreenFont}"/><Setter Property="Foreground" Value="{StaticResource --ink}"/><Setter Property="CaretBrush" Value="{StaticResource --ink}"/><Setter Property="FontSize" Value="14.4"/><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="40,0,12.8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#14FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource --line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource FsFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12.8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenRowStyle" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="9.6,8.8"/><Setter Property="Foreground" Value="{StaticResource --ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FsFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="14.4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource FsRowHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource FsRowActive}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenSeekStyle" TargetType="ui:MediaSlider">
    <Setter Property="PointInset" Value="0"/><Setter Property="Height" Value="25.6"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource FsFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:MediaSlider"><Grid Background="Transparent">
      <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Height="25.6" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="Fill" Height="4.8" Background="{StaticResource --acc}" CornerRadius="9" VerticalAlignment="Center"/><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:MediaSlider}}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Height" To="8" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Height" To="4.8" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="0" Height="25.6"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource --acc}" Opacity="0"><Ellipse.Effect><DropShadowEffect Color="#C5F27A" BlurRadius="12.8" ShadowDepth="0" Opacity="0.22"/></Ellipse.Effect></Ellipse></Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:MediaSlider}}" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="1"/></DataTrigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="Track" Height="4.8" Background="#38FFFFFF" CornerRadius="9" VerticalAlignment="Center"/><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:MediaSlider}}" Value="True"><Setter TargetName="Track" Property="Height" Value="8"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenVolumeStyle" TargetType="ui:MediaSlider" BasedOn="{StaticResource FullscreenSeekStyle}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:MediaSlider"><Grid Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Height="25.6"><Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="{StaticResource --acc}" CornerRadius="9" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="25.6"><Thumb.Template><ControlTemplate><Ellipse Width="12" Height="12" Fill="{StaticResource --acc}" VerticalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#38FFFFFF" CornerRadius="9" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FullscreenSourceBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource --glass}"/><Setter Property="BorderBrush" Value="{StaticResource --line}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12.8"/><Setter Property="Padding" Value="12.8,9.6"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MaxWidth" Value="240"/><Setter Property="Margin" Value="16,0,0,0"/>
  </Style>
</ResourceDictionary>
