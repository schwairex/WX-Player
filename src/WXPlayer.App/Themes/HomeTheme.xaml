<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CatalogTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <!-- Home HTML tokens stay scoped here; the fullscreen dictionary is untouched. -->
  <SolidColorBrush x:Key="--live" Color="#FF6B78" />
  <SolidColorBrush x:Key="HomeLiveText" Color="#FFB0B8" />
  <SolidColorBrush x:Key="HomeEmptyLine" Color="#1FFFFFFF" />
  <Style x:Key="HomeDot" TargetType="Button" BasedOn="{StaticResource CatalogButton}">
    <Setter Property="Height" Value="8" /><Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="#4DFFFFFF" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeShelfArrow" TargetType="Button" BasedOn="{StaticResource CatalogIconButton}">
    <Setter Property="Width" Value="44.8" /><Setter Property="Height" Value="44.8" />
    <Setter Property="Background" Value="{StaticResource CatalogArrowGlass}" />
    <Setter Property="BorderBrush" Value="{StaticResource --line}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="0.4" />
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeChannelCard" TargetType="Button" BasedOn="{StaticResource CatalogCardButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        <Border Name="HoverPane" Height="125" VerticalAlignment="Top" CornerRadius="16" Background="#73000000" Opacity="0" IsHitTestVisible="False">
          <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource --ink}" HorizontalAlignment="Center" VerticalAlignment="Center"><ui:SvgIcon Icon="fs-v2-play" Width="17.6" Height="17.6" Foreground="{StaticResource CatalogDarkInk}" /></Border>
        </Border>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverPane" Property="Opacity" Value="1" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HoverPane" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
