<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LiveTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Settings reference: shared neutral palette/Manrope, scoped additions only. -->
  <SolidColorBrush x:Key="SettingsSelected" Color="#1FC5F27A"/><SolidColorBrush x:Key="SettingsButtonBg" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="SettingsHover" Color="#24FFFFFF"/><SolidColorBrush x:Key="SettingsPrimaryHover" Color="#D3F79A"/>
  <SolidColorBrush x:Key="SettingsDanger" Color="#FF8C98"/><SolidColorBrush x:Key="SettingsDangerBg" Color="#1AFF6B78"/><SolidColorBrush x:Key="SettingsDangerHover" Color="#33FF6B78"/>
  <SolidColorBrush x:Key="SettingsSwitchOff" Color="#2B3338"/><SolidColorBrush x:Key="SettingsSwitchKnob" Color="#CFD6D2"/>
  <Style x:Key="SettingsButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource LiveFont}"/><Setter Property="FontSize" Value="13.6"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="Background" Value="{StaticResource SettingsButtonBg}"/>
    <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="17.6,0"/><Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <ui:CatalogPillBorder x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}" TransitionSeconds=".15"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></ui:CatalogPillBorder>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SettingsHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPrimary" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Background" Value="{StaticResource LiveAccent}"/><Setter Property="Foreground" Value="{StaticResource LiveDarkInk}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SettingsPrimaryHover}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SettingsDangerButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Foreground" Value="{StaticResource SettingsDanger}"/><Setter Property="Background" Value="{StaticResource SettingsDangerBg}"/></Style>
  <Style x:Key="SettingsSmallButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Height" Value="33.6"/><Setter Property="FontSize" Value="12.8"/><Setter Property="Padding" Value="14.4,0"/></Style>
  <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Height" Value="44.8"/><Setter Property="Padding" Value="13.6,0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="FontSize" Value="14.72"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LiveMuted}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ui:SettingsChrome x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13.6" Padding="{TemplateBinding Padding}" ui:CatalogPillBorder.TransitionSeconds=".15"><Grid><Border x:Name="Mark" Width="3" Background="{StaticResource LiveAccent}" CornerRadius="3" HorizontalAlignment="Left" Margin="-14.4,11.2,0,11.2" Visibility="Collapsed"/><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/></Grid></ui:SettingsChrome>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveRaised}"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Trigger><Trigger Property="ui:NavigationVisual.IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SettingsSelected}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSwitch" TargetType="CheckBox">
    <Setter Property="Width" Value="44.8"/><Setter Property="Height" Value="25.6"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><ui:CatalogPillBorder x:Name="Track" Background="{StaticResource SettingsSwitchOff}" CornerRadius="999" TransitionSeconds=".2"><Ellipse x:Name="Knob" Width="19.2" Height="19.2" Margin="3.2,0,0,0" Fill="{StaticResource SettingsSwitchKnob}" HorizontalAlignment="Left"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse></ui:CatalogPillBorder>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource LiveAccent}"/><Setter TargetName="Knob" Property="Fill" Value="{StaticResource LiveDarkInk}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="19.2" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".9"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsInput" TargetType="TextBox">
    <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="14.4,0"/><Setter Property="FontFamily" Value="{StaticResource LiveFont}"/><Setter Property="FontSize" Value="14.08"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="CaretBrush" Value="{StaticResource LiveInk}"/><Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12.8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsOutput" TargetType="ComboBox" BasedOn="{StaticResource LiveCombo}"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="14.08"/><Setter Property="Padding" Value="14.4,0,30,0"/></Style>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource LiveRaised}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17.6"/></Style>
</ResourceDictionary>
