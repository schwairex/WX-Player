<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <!-- wx-player-canli-tv-v3.html: 1 rem = 16 DIP before the existing viewport/DPI scale.
       CSS names stay scoped here so fullscreen/Home/Catalog tokens cannot be shadowed. -->
  <Color x:Key="LiveColorAccent">#C5F27A</Color>
  <Color x:Key="LiveColorBg">#0A0C0E</Color>
  <Color x:Key="LiveColorHover">#1F262B</Color>
  <Color x:Key="LiveColorMuted">#8F9996</Color>
  <Color x:Key="LiveColorLine">#12FFFFFF</Color>
  <Color x:Key="LiveColorOnAir">#FF6B78</Color>
  <Color x:Key="LiveColorRaised">#171C20</Color>
  <Color x:Key="LiveColorPanel">#101417</Color>
  <Color x:Key="LiveColorInk">#F2F5EE</Color>
  <Color x:Key="LiveColorGlass">#C2101315</Color>
  <ResourceDictionary x:Key="LiveTokens">
    <SolidColorBrush x:Key="--bg" Color="{StaticResource LiveColorBg}"/><SolidColorBrush x:Key="--p1" Color="{StaticResource LiveColorPanel}"/>
    <SolidColorBrush x:Key="--p2" Color="{StaticResource LiveColorRaised}"/><SolidColorBrush x:Key="--p3" Color="{StaticResource LiveColorHover}"/>
    <SolidColorBrush x:Key="--ink" Color="{StaticResource LiveColorInk}"/><SolidColorBrush x:Key="--mut" Color="{StaticResource LiveColorMuted}"/>
    <SolidColorBrush x:Key="--acc" Color="{StaticResource LiveColorAccent}"/><SolidColorBrush x:Key="--live" Color="{StaticResource LiveColorOnAir}"/>
    <SolidColorBrush x:Key="--line" Color="{StaticResource LiveColorLine}"/><SolidColorBrush x:Key="--glass" Color="{StaticResource LiveColorGlass}"/>
  </ResourceDictionary>
  <SolidColorBrush x:Key="LiveBg" Color="{StaticResource LiveColorBg}"/><SolidColorBrush x:Key="LivePanel" Color="{StaticResource LiveColorPanel}"/>
  <SolidColorBrush x:Key="LiveRaised" Color="{StaticResource LiveColorRaised}"/><SolidColorBrush x:Key="LiveHover" Color="{StaticResource LiveColorHover}"/>
  <SolidColorBrush x:Key="LiveInk" Color="{StaticResource LiveColorInk}"/><SolidColorBrush x:Key="LiveMuted" Color="{StaticResource LiveColorMuted}"/>
  <SolidColorBrush x:Key="LiveAccent" Color="{StaticResource LiveColorAccent}"/><SolidColorBrush x:Key="LiveOnAir" Color="{StaticResource LiveColorOnAir}"/>
  <SolidColorBrush x:Key="LiveLine" Color="{StaticResource LiveColorLine}"/><SolidColorBrush x:Key="LiveGlass" Color="{StaticResource LiveColorGlass}"/>
  <SolidColorBrush x:Key="LiveSelected" Color="#1AC5F27A"/><SolidColorBrush x:Key="LiveNavSelected" Color="#24C5F27A"/>
  <SolidColorBrush x:Key="LiveProgrammeNow" Color="#12C5F27A"/><SolidColorBrush x:Key="LiveProgrammeLine" Color="#73C5F27A"/>
  <SolidColorBrush x:Key="LiveLogoBackground" Color="#2A3330"/><SolidColorBrush x:Key="LiveCaption" Color="#C4CBC7"/>
  <SolidColorBrush x:Key="LiveButtonHover" Color="#1FFFFFFF"/><SolidColorBrush x:Key="LiveTrack" Color="#38FFFFFF"/>
  <SolidColorBrush x:Key="LiveDarkInk" Color="#10160A"/>
  <FontFamily x:Key="LiveFont">pack://application:,,,/WXPlayer;component/Assets/Fonts/#Manrope</FontFamily>
  <Style x:Key="LiveFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource LiveAccent}" BorderThickness="2" CornerRadius="9.6" Margin="-4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="LiveButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource LiveFont}"/><Setter Property="FontSize" Value="14.08"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ui:CatalogPillBorder x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}" ui:CatalogPillBorder.TransitionSeconds=".15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ui:CatalogPillBorder>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveButtonHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LiveIconButton" TargetType="Button" BasedOn="{StaticResource LiveButton}"><Setter Property="Width" Value="44.8"/><Setter Property="Height" Value="44.8"/></Style>
  <Style x:Key="LiveHeaderButton" TargetType="Button" BasedOn="{StaticResource LiveIconButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Foreground" Value="{StaticResource LiveMuted}"/></Style>
  <Style x:Key="LiveAddSource" TargetType="Button" BasedOn="{StaticResource LiveButton}"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="17.6,0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Background" Value="{StaticResource LiveAccent}"/><Setter Property="Foreground" Value="{StaticResource LiveDarkInk}"/></Style>
  <Style x:Key="LivePlayButton" TargetType="Button" BasedOn="{StaticResource LiveIconButton}">
    <Setter Property="Width" Value="54.4"/><Setter Property="Height" Value="54.4"/><Setter Property="Margin" Value="6.4,0"/>
    <Setter Property="Foreground" Value="#0C0F10"/><Setter Property="Background" Value="{StaticResource LiveInk}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ui:CatalogPillBorder x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ui:CatalogPillBorder><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Setter Property="RenderTransformOrigin" Value=".5,.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="LiveMenuAction" TargetType="Button" BasedOn="{StaticResource LiveButton}">
    <Setter Property="Padding" Value="8,8.8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11.2" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29.6"/><ColumnDefinition/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LiveCombo" TargetType="ComboBox">
    <Setter Property="Height" Value="41.6"/><Setter Property="FontFamily" Value="{StaticResource LiveFont}"/><Setter Property="FontSize" Value="14.08"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="Background" Value="{StaticResource LiveRaised}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="Padding" Value="14.4,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="14.4"><ui:SvgIcon Icon="chevron-down" Width="16" Height="16" HorizontalAlignment="Right" Foreground="{StaticResource LiveMuted}" Margin="0,0,14.4,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#161B1F" BorderBrush="{StaticResource LiveLine}" BorderThickness="1" CornerRadius="16" Padding="6.4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="11.2,9.6"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="10.4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource LiveLine}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="LiveSource" TargetType="ComboBox" BasedOn="{StaticResource LiveCombo}"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13.6"/><Setter Property="Padding" Value="32,0,36,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ui:CatalogPillBorder x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="999"><ui:SvgIcon Icon="chevron-down" Width="16" Height="16" HorizontalAlignment="Right" Foreground="{StaticResource LiveMuted}" Margin="0,0,14.4,0"/></ui:CatalogPillBorder><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <Ellipse Width="8" Height="8" Fill="{StaticResource LiveAccent}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#161B1F" BorderBrush="{StaticResource LiveLine}" BorderThickness="1" CornerRadius="16" Padding="6.4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="LiveChannelRow" TargetType="ListBoxItem">
    <Setter Property="Height" Value="57.6"/><Setter Property="Padding" Value="9.6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="13.6" Padding="{TemplateBinding Padding}"><Grid><Border x:Name="Mark" Width="3" HorizontalAlignment="Left" Background="{StaticResource LiveAccent}" CornerRadius="3" Margin="-9.6,14.4,0,14.4" Visibility="Collapsed"/><ContentPresenter/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource LiveRaised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource LiveSelected}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource LiveAccent}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <ItemsPanelTemplate x:Key="LiveEpgPanel"><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  <Style x:Key="LiveEpgCard" TargetType="ListBoxItem">
    <Setter Property="Width" Value="272"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,13.6"/><Setter Property="Margin" Value="0,0,11.2,8"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{StaticResource LivePanel}" BorderBrush="{StaticResource LiveLine}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding StateLabel}" Value="GEÇMİŞ"><Setter Property="Opacity" Value=".5"/></DataTrigger><DataTrigger Binding="{Binding IsNow}" Value="True"><Setter Property="Width" Value="352"/><Setter TargetName="Card" Property="Background" Value="{StaticResource LiveProgrammeNow}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LiveProgrammeLine}"/></DataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LiveProgress" TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="LiveEpgTemplate"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" FontSize="11.84" Foreground="{StaticResource LiveMuted}"/><TextBlock x:Name="State" Text="{Binding StateLabel}" FontSize="11.84" Foreground="{StaticResource LiveMuted}"/></DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14.72" FontWeight="Bold" Margin="0,5.6,0,3.2" LineHeight="18.4" MaxHeight="36.8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12.48" Foreground="{StaticResource LiveMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
    <ProgressBar Style="{StaticResource LiveProgress}" x:Name="Progress" Grid.Row="4" Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,11.2,0,0" Foreground="{StaticResource LiveAccent}" Background="{StaticResource LiveButtonHover}" BorderThickness="0" Visibility="Hidden"/>
  </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsNow}" Value="True"><Setter TargetName="State" Property="Foreground" Value="{StaticResource LiveAccent}"/><Setter TargetName="State" Property="FontWeight" Value="Bold"/><Setter TargetName="Progress" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  <Style x:Key="LiveSlider" TargetType="ui:MediaSlider">
    <Setter Property="Height" Value="24"/><Setter Property="PointInset" Value="6.8"/><Setter Property="Foreground" Value="{StaticResource LiveOnAir}"/><Setter Property="Background" Value="{StaticResource LiveTrack}"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:MediaSlider"><Grid Background="Transparent" Margin="6.8,0"><Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Focusable="False" IsHitTestVisible="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="Fill" Height="3.52" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="9"/><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"><Setter TargetName="Fill" Property="Height" Value="6.4"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Focusable="False" IsHitTestVisible="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="Rest" Height="3.52" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="9"/><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"><Setter TargetName="Rest" Property="Height" Value="6.4"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="13.6" Height="13.6"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LiveNav" TargetType="Button" BasedOn="{StaticResource LiveButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13.6" Padding="{TemplateBinding Padding}" ui:CatalogPillBorder.TransitionSeconds=".15"><Grid><Border x:Name="Mark" Background="{StaticResource LiveAccent}" Width="3" Margin="-12.8,12.8,0,12.8" HorizontalAlignment="Left" CornerRadius="3" Visibility="Collapsed"/><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveRaised}"/></Trigger><Trigger Property="ui:NavigationVisual.IsSelected" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="LiveGearButton" TargetType="ToggleButton"><Setter Property="Width" Value="44.8"/><Setter Property="Height" Value="44.8"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" CornerRadius="999" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveButtonHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveButtonHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="LiveScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid x:Name="ScrollbarChrome" Background="Transparent" Width="6" HorizontalAlignment="Right"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinWidth="6" MinHeight="6"><Thumb.Template><ControlTemplate><Border Background="#2A3238" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="ScrollbarChrome" Property="Width" Value="Auto"/><Setter TargetName="ScrollbarChrome" Property="Height" Value="6"/><Setter TargetName="ScrollbarChrome" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>