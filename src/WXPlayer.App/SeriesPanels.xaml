<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LibraryPanels.xaml"/></ResourceDictionary.MergedDictionaries>
  <ui:SeriesTextConverter x:Key="SeriesText"/>
  <ui:SeriesCardProgressConverter x:Key="SeriesCardProgress"/>
  <Style x:Key="SeriesSeasonPill" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/><Setter Property="Foreground" Value="{StaticResource LiveMuted}"/><Setter Property="Padding" Value="9.6,0"/><Setter Property="MinWidth" Value="30.4"/><Setter Property="Height" Value="30.4"/><Setter Property="FontSize" Value="12.48"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ui:CatalogPillBorder x:Name="Chrome" CornerRadius="999" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ui:CatalogPillBorder><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveHover}"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource LiveInk}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SeriesEpisodeRow" TargetType="ListBoxItem">
    <Setter Property="Width" Value="216"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,11.2,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SeriesEpisodeButton" TargetType="Button" BasedOn="{StaticResource LiveButton}">
    <Setter Property="Padding" Value="16,13.6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource LiveRaised}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LiveAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="SeriesEpisodeCard">
    <Button x:Name="Card" Tag="{Binding}" Style="{StaticResource SeriesEpisodeButton}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="State" Text="{Binding Converter={StaticResource SeriesText},ConverterParameter=Code}" Foreground="{StaticResource LiveMuted}" FontSize="11.84"/>
        <TextBlock x:Name="Code" Grid.Column="1" Text="{Binding Converter={StaticResource SeriesText},ConverterParameter=Code}" Foreground="{StaticResource LiveAccent}" FontSize="11.84" Visibility="Collapsed"/>
        <TextBlock x:Name="Watched" Grid.Column="1" Text="✓ İzlendi" Foreground="{StaticResource LiveAccent}" FontSize="11.84" Visibility="Collapsed"/>
      </Grid><TextBlock Text="{Binding Converter={StaticResource SeriesText},ConverterParameter=EpisodeTitle}" Foreground="{StaticResource LiveInk}" FontSize="14.72" FontWeight="ExtraBold" Margin="0,5.6,0,3.2" TextTrimming="CharacterEllipsis"/>
      <ProgressBar Maximum="1" Height="3" Margin="0,11.2,0,0" Style="{StaticResource LiveProgress}" Foreground="{StaticResource LiveAccent}" Background="#1FFFFFFF" IsHitTestVisible="False"><ProgressBar.Value><MultiBinding Mode="OneWay" Converter="{StaticResource SeriesCardProgress}"><Binding/><Binding Path="(ui:LibraryPresentation.PlayingItem)" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="(ui:LibraryPresentation.PlaybackPosition)" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></ProgressBar.Value></ProgressBar>
      </StackPanel>
    </Button>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Progress.Completed}" Value="True"><Setter TargetName="Watched" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource LibraryPlaying}"><Binding/><Binding Path="(ui:LibraryPresentation.PlayingItem)" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></DataTrigger.Binding>
        <Setter TargetName="Card" Property="BorderBrush" Value="#73C5F27A"/><Setter TargetName="Card" Property="Background" Value="#12C5F27A"/><Setter TargetName="State" Property="Text" Value="Şimdi oynuyor"/><Setter TargetName="State" Property="Foreground" Value="{StaticResource LiveAccent}"/><Setter TargetName="State" Property="FontWeight" Value="Bold"/><Setter TargetName="Code" Property="Visibility" Value="Visible"/><Setter TargetName="Watched" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
