<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UtilityTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="SourceSelectedBackground" Color="#1AC5F27A"/>
  <SolidColorBrush x:Key="SourceSelectedLine" Color="#8CC5F27A"/>
  <SolidColorBrush x:Key="SourceLabelInk" Color="#AAB3B0"/>
  <SolidColorBrush x:Key="SourceHintInk" Color="#5F6967"/>
  <Style x:Key="SourceOption" TargetType="Button">
    <Setter Property="Height" Value="54.4"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="14.72"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource LiveMuted}"/><Setter Property="Background" Value="{StaticResource LiveRaised}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <ui:SettingsChrome CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,0">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </ui:SettingsChrome>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="BorderBrush" Value="{StaticResource UtilityHoverLine}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".8"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SourceSelectedOption" TargetType="Button" BasedOn="{StaticResource SourceOption}">
    <Setter Property="Background" Value="{StaticResource SourceSelectedBackground}"/><Setter Property="BorderBrush" Value="{StaticResource SourceSelectedLine}"/><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/><Setter Property="BorderBrush" Value="{StaticResource SourceSelectedLine}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SourceInput" TargetType="TextBox">
    <Setter Property="Height" Value="46.4"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15.2"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="CaretBrush" Value="{StaticResource LiveAccent}"/>
    <Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Chrome" CornerRadius="14.4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UtilityHoverLine}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SourceSelectedLine}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SourcePassword" TargetType="PasswordBox">
    <Setter Property="Height" Value="46.4"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15.2"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/><Setter Property="CaretBrush" Value="{StaticResource LiveAccent}"/>
    <Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="BorderBrush" Value="{StaticResource LiveLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource LiveFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Chrome" CornerRadius="14.4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UtilityHoverLine}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SourceSelectedLine}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SourceButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Height" Value="46.4"/><Setter Property="Padding" Value="19.2,0"/></Style>
  <Style x:Key="SourcePrimary" TargetType="Button" BasedOn="{StaticResource SettingsPrimary}"><Setter Property="Height" Value="46.4"/><Setter Property="Padding" Value="19.2,0"/></Style>
</ResourceDictionary>
