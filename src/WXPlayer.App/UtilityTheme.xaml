<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WXPlayer.App">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- Scoped HTML reference additions. Shared Settings/Live resources retain their keys. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FF8C98"/>
  <SolidColorBrush x:Key="UtilityWarning" Color="#F2C94C"/>
  <SolidColorBrush x:Key="UtilityWarningBg" Color="#24F2C94C"/>
  <SolidColorBrush x:Key="UtilityLiveBg" Color="#1FFF6B78"/>
  <SolidColorBrush x:Key="UtilityLiveInk" Color="#FFB0B8"/>
  <SolidColorBrush x:Key="UtilityNeutralInk" Color="#CFD6D2"/>
  <SolidColorBrush x:Key="UtilityTagInk" Color="#B9C2BE"/>
  <SolidColorBrush x:Key="UtilityPopup" Color="#F2161B1F"/>
  <SolidColorBrush x:Key="UtilityHoverLine" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="UtilityOpenLine" Color="#8CC5F27A"/>
  <SolidColorBrush x:Key="UtilityOpenRing" Color="#1FC5F27A"/>
  <ui:TrackLabelDisplayConverter x:Key="TrackLabelDisplay"/>
  <DataTemplate x:Key="UtilityTrackLabel">
    <Grid ToolTip="{Binding Label}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label, Converter={StaticResource TrackLabelDisplay}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding Label, Converter={StaticResource TrackLabelDisplay}, ConverterParameter=track}" Foreground="{StaticResource LiveMuted}" FontSize="12.48" FontWeight="Medium" VerticalAlignment="Center" Margin="12.8,0,0,0"/>
    </Grid>
  </DataTemplate>
  <Style x:Key="UtilityTrackItem" TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="12,10.4"/><Setter Property="Margin" Value="0,1,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource LiveInk}"/>
    <Setter Property="FontSize" Value="14.72"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="ToolTip" Value="{Binding Label}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="11.2" Background="Transparent">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <ContentPresenter HorizontalAlignment="Stretch"/>
          <TextBlock x:Name="Tick" Grid.Column="1" Text="✓" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource LiveLine}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource LiveAccent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Same shared Settings ComboBox foundation, with a local visual template for track labels. -->
  <Style x:Key="UtilityTrackPicker" TargetType="ComboBox" BasedOn="{StaticResource SettingsOutput}">
    <Setter Property="ToolTip" Value="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="15.2"/><Setter Property="Padding" Value="16,0,40,0"/>
    <Setter Property="Background" Value="{StaticResource LivePanel}"/><Setter Property="ItemTemplate" Value="{StaticResource UtilityTrackLabel}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource UtilityTrackItem}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="3" CornerRadius="17.4" Margin="-3" IsHitTestVisible="False"/>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="14.4"/></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14.4" IsHitTestVisible="False"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>
        <ui:SvgIcon x:Name="Arrow" Icon="chevron-down" Width="16.8" Height="16.8" Foreground="{StaticResource LiveMuted}" HorizontalAlignment="Right" Margin="0,0,16,0" IsHitTestVisible="False" RenderTransformOrigin=".5,.5"><ui:SvgIcon.RenderTransform><RotateTransform/></ui:SvgIcon.RenderTransform></ui:SvgIcon>
        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6.4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
          <Border Background="{StaticResource UtilityPopup}" BorderBrush="{StaticResource LiveLine}" BorderThickness="1" CornerRadius="16" Padding="5.6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UtilityHoverLine}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UtilityOpenLine}"/></Trigger>
        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UtilityOpenLine}"/><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource UtilityOpenRing}"/><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UtilityMiniIcon" TargetType="Button" BasedOn="{StaticResource LiveHeaderButton}">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="UtilityMiniPlay" TargetType="Button" BasedOn="{StaticResource LivePlayButton}">
    <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="UtilityMiniProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/><Setter Property="Foreground" Value="{DynamicResource PlayerProgressFillBrush}"/><Setter Property="Background" Value="{DynamicResource PlayerProgressTrackBrush}"/>
    <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid Background="{TemplateBinding Background}"><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
