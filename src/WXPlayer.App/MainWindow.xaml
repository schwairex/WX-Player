<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WXPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WX Player" Width="1440" Height="920" MinWidth="900" MinHeight="650" Style="{StaticResource AppWindow}" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged" Closing="Window_Closing" xmlns:ui="clr-namespace:WXPlayer.App" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid x:Name="Root" Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="210" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#10141C" BorderBrush="#242B36" BorderThickness="0,0,1,0" Padding="18,26,18,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="5,0,0,33">
            <Border Background="{StaticResource Accent}" CornerRadius="10" Width="42" Height="42">
              <TextBlock Text="W" FontWeight="Black" Foreground="#18240B" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="BrandWordmark" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WX Player" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="YOUR WORLD. YOUR PLAY." FontSize="8.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="NavLabel" Text="KÜTÜPHANE" Foreground="#69778D" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,10" />
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Tag="home" Click="Navigate_Click">
            <ui:IconLabel Icon="home" Label="Ana sayfa" />
          </Button>
          <Button x:Name="LiveNav" Style="{StaticResource Nav}" Tag="live" Click="Navigate_Click">
            <ui:IconLabel Icon="tv" Label="Canlı TV" />
          </Button>
          <Button x:Name="MovieNav" Style="{StaticResource Nav}" Tag="movie" Click="Navigate_Click">
            <ui:IconLabel Icon="film" Label="Filmler" />
          </Button>
          <Button x:Name="SeriesNav" Style="{StaticResource Nav}" Tag="series" Click="Navigate_Click">
            <ui:IconLabel Icon="series" Label="Diziler" />
          </Button>
          <Border Height="1" Background="#252C38" Margin="10,19" />
          <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Tag="favorites" Click="Navigate_Click">
            <ui:IconLabel Icon="star" Label="Favorilerim" />
          </Button>
          <Button x:Name="EpgNav" Style="{StaticResource Nav}" Tag="epg" Click="Navigate_Click">
            <ui:IconLabel Icon="epg" Label="Program rehberi" />
          </Button>
          <Button x:Name="RecentNav" Style="{StaticResource Nav}" Tag="recent" Click="Navigate_Click">
            <ui:IconLabel Icon="history" Label="Son izlenenler" />
          </Button>
          <Button x:Name="RecordingsNav" Style="{StaticResource Nav}" Click="Recordings_Click">
            <ui:IconLabel Icon="recordings" Label="Kayıtlarım" />
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="PromoCard" Background="#1B261C" BorderBrush="#34432A" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="●  Sizin kütüphaneniz" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="Kendi kaynağınızı bağlayın.&#xA;İzleme deneyimini siz yönetin." Foreground="#A8B79D" FontSize="10.5" LineHeight="18" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click">
            <ui:IconLabel Icon="settings" Label="Ayarlar" />
          </Button>
          <TextBlock x:Name="VersionLabel" Text="WX PLAYER  /  1.1.0" FontSize="9" Foreground="#5F6D81" Margin="14,14,0,0" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="MainArea" Margin="28,22,28,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="TopBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="İYİ SEYİRLER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock x:Name="PageTitle" Text="Ana sayfa" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <ComboBox x:Name="SourcePicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Source_Changed" ToolTip="Aktif kaynak" AutomationProperties.Name="Aktif kaynak" />
        <Button Grid.Column="2" x:Name="AddSourceButton" Style="{StaticResource Primary}" Click="AddSource_Click" VerticalAlignment="Center" Margin="12,0,0,0">
          <ui:IconLabel Icon="plus" Label="Kaynak ekle" />
        </Button>
      </Grid>
      <Grid x:Name="StatsBar" Grid.Row="1" Margin="0,24,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0">
          <DockPanel>
            <ui:SvgIcon Icon="tv" Width="21" Height="21" Foreground="{StaticResource Accent}" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock x:Name="LiveCount" Text="0" FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Canlı kanal" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0">
          <DockPanel>
            <ui:SvgIcon Icon="film" Width="21" Height="21" Foreground="#A7B5FF" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock x:Name="MovieCount" Text="0" FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Film" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0">
          <DockPanel>
            <ui:SvgIcon Icon="series" Width="21" Height="21" Foreground="#E2B3F5" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock x:Name="SeriesCount" Text="0" FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Dizi" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Column="3" Background="#151C25" CornerRadius="10" Padding="16,12">
          <DockPanel>
            <ui:SvgIcon Icon="star" Width="21" Height="21" Foreground="#F3D48D" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock x:Name="FavoriteCount" Text="0" FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Favori" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
      <Grid x:Name="FilterBar" Grid.Row="2" Margin="0,0,0,16" Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Kanal, film, dizi veya kategori ara · Ctrl+K" AutomationProperties.Name="Kütüphanede ara" Padding="34,10,12,10" />
          <ui:SvgIcon Icon="search" Width="19" Height="19" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock x:Name="SearchHint" Text="Kütüphanenizde arayın…" Foreground="#76859B" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <ComboBox x:Name="CategoryPicker" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Category_Changed" ToolTip="Kategori filtresi" AutomationProperties.Name="Kategori" />
        <Button Grid.Column="2" Click="Refresh_Click" ToolTip="Kaynağı yenile" FontSize="19" Margin="10,0,0,0" Padding="13,5" MinWidth="32" MinHeight="32">
          <ui:SvgIcon Icon="refresh" />
        </Button>
        <Button Grid.Column="3" Click="ManageSource_Click" ToolTip="Kaynağı düzenle veya kaldır" Margin="8,0,0,0" MinWidth="32" MinHeight="32">
          <ui:SvgIcon Icon="more" />
        </Button>
      </Grid>
      <Grid Grid.Row="3" x:Name="ContentGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="355" />
          <ColumnDefinition x:Name="GapColumn" Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="LibraryPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="ResultsCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            <TextBlock x:Name="ListTitle" Text="Kütüphaneniz" FontSize="16" FontWeight="SemiBold" />
          </DockPanel>
          <ListBox x:Name="ChannelList" Grid.Row="1" SelectionChanged="Channel_Selected" MouseDoubleClick="Channel_DoubleClick" AutomationProperties.Name="İçerik listesi">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#2A3442" CornerRadius="9" Width="42" Height="42">
                    <TextBlock Text="{Binding Initials}" Foreground="#C9D6E8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="{Binding KindLabel}" Foreground="#A4C582" FontSize="9" Margin="0,1,7,0" />
                      <TextBlock Text="{Binding Category}" Foreground="#8391A6" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Tag="{Binding}" Click="Favorite_Click" Background="Transparent" BorderThickness="0" Foreground="#D3E7B9" FontSize="20" Padding="0" ToolTip="Favoriyi değiştir" AutomationProperties.Name="Favoriyi değiştir">
                    <ui:SvgIcon Icon="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyList" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="265">
            <ui:SvgIcon Icon="series" Width="21" Height="21" Foreground="#67758B" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="İlk kaynağınızı ekleyin" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,8" />
            <TextBlock x:Name="EmptyDescription" Text="M3U, Xtream veya Stalker ile tüm içeriklerinize tek yerden ulaşın." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
            <Button x:Name="DemoButton" Click="Demo_Click" Margin="0,20,0,0" Background="Transparent" Foreground="{StaticResource Accent}">
              <ui:IconLabel Icon="arrow-right" Label="Örnek yayınları keşfet" />
            </Button>
          </StackPanel>
          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="PrevPage" DockPanel.Dock="Left" Click="PrevPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-left" />
            </Button>
            <Button x:Name="NextPage" DockPanel.Dock="Right" Click="NextPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-right" />
            </Button>
            <TextBlock x:Name="PageLabel" Text="0 içerik" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
          </DockPanel>
        </Grid>
        <Grid x:Name="ViewingPanel" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="GuideRow" Height="190" />
          </Grid.RowDefinitions>
          <Border x:Name="VideoBorder" CornerRadius="14,14,0,0" Background="#090C12" BorderBrush="#2A3340" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Grid x:Name="WelcomePanel" ClipToBounds="True">
                <Grid.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1C2C27" />
                    <GradientStop Color="#121C23" Offset="0.5" />
                    <GradientStop Color="#20243B" Offset="1" />
                  </LinearGradientBrush>
                </Grid.Background>
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="290" Height="280" Opacity="0.45">
                  <Ellipse Width="290" Height="290" Stroke="#607D5C" StrokeThickness="1" Canvas.Left="50" Canvas.Top="-15" />
                  <Ellipse Width="220" Height="220" Stroke="#779764" StrokeThickness="1" Canvas.Left="85" Canvas.Top="20" />
                  <Ellipse Width="150" Height="150" Stroke="#9EBF75" StrokeThickness="1" Canvas.Left="120" Canvas.Top="55" />
                  <Ellipse Width="82" Height="82" Fill="#537849" Canvas.Left="154" Canvas.Top="89" />
                  <Path Data="M 0,0 L 0,35 L 28,17.5 Z" Fill="#D8F7B0" Canvas.Left="185" Canvas.Top="113" />
                  <Ellipse Width="12" Height="12" Fill="#C4F571" Canvas.Left="88" Canvas.Top="38" />
                </Canvas>
                <StackPanel VerticalAlignment="Center" Margin="28,24" MaxWidth="440" HorizontalAlignment="Left">
                  <Border Background="#273D2D" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left">
                    <TextBlock Text="TAMAMEN SİZİN KONTROLÜNÜZDE" Foreground="#C3E9AA" FontSize="9" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="Televizyon,&#xA;sizin ritminizde." FontSize="34" FontWeight="SemiBold" Margin="0,16,0,12" LineHeight="39" />
                  <TextBlock Text="Canlı yayınlar, sevdiğiniz filmler ve diziler.&#xA;Hepsi tek, sade bir oynatıcıda." Foreground="#A4B7BB" FontSize="12" LineHeight="21" />
                  <Button Style="{StaticResource Primary}" Click="AddSource_Click" HorizontalAlignment="Left" Margin="0,22,0,0">
                    <ui:IconLabel Icon="plus" Label="Kütüphaneni bağla" />
                  </Button>
                </StackPanel>
              </Grid>
              <ui:NativeVideoHost x:Name="Video" Visibility="Collapsed" />
            </Grid>
          </Border>
          <Border Grid.Row="1" x:Name="ControlsBorder" Background="#171D27" CornerRadius="0,0,14,14" Padding="16,12">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="PlaybackBadge" DockPanel.Dock="Right" Text="HAZIR" Foreground="{StaticResource Accent}" FontSize="9" VerticalAlignment="Center" />
                <TextBlock x:Name="NowTitle" Text="Bir içerik seçin" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" PreviewMouseLeftButtonUp="Seek_Released" Margin="0,9,0,6" IsEnabled="False" ToolTip="Yayın konumu" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Button Click="PreviousChannel_Click" ToolTip="Önceki kanal · Page Up" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-back" />
                  </Button>
                  <Button x:Name="PlayButton" Click="PlayPause_Click" ToolTip="Oynat / duraklat · Space" Padding="10,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="play" />
                  </Button>
                  <Button Click="NextChannel_Click" ToolTip="Sonraki kanal · Page Down" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-next" />
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="MuteButton" Click="Mute_Click" ToolTip="Sessiz · M" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="volume" />
                  </Button>
                  <Slider x:Name="VolumeSlider" Width="60" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center" ToolTip="Ses" />
                  <TextBlock x:Name="VolumeLabel" Text="75" Foreground="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <Button x:Name="FitButton" Click="Fit_Click" ToolTip="Görüntü: sığdır / ekranı doldur · Z" Padding="9,5" Background="Transparent" BorderThickness="0">
                    <ui:SvgIcon Icon="fill" />
                  </Button>
                  <Button x:Name="RecordButton" Foreground="#FF8C91" Click="Record_Click" ToolTip="Kaydı başlat / bitir" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="record" />
                  </Button>
                  <Button Click="Tracks_Click" ToolTip="Ses ve altyazı parçaları" FontSize="10" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="subtitles" />
                  </Button>
                  <Button Click="Fullscreen_Click" ToolTip="Tam ekran · F" FontSize="19" Padding="9,0" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="maximize" />
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="GuidePanel" Grid.Row="2" Background="#141A24" CornerRadius="12" Padding="18" Margin="0,16,0,0" BorderBrush="#242E3B" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Click="PreviousDay_Click" Padding="7,0" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="chevron-left" />
                  </Button>
                  <TextBlock x:Name="GuideDate" Text="BUGÜN" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0" />
                  <Button Click="NextDay_Click" Padding="7,0" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="chevron-right" />
                  </Button>
                  <Button Click="RefreshEpg_Click" Padding="7,0" Background="Transparent" BorderThickness="0" ToolTip="XMLTV rehberini güncelle" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="refresh" />
                  </Button>
                </StackPanel>
                <TextBlock Text="Yayın akışı" FontSize="13" FontWeight="SemiBold" />
              </DockPanel>
              <ListBox x:Name="EpgList" Grid.Row="1" Margin="0,9,0,0" MouseDoubleClick="Epg_DoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="65" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#A4B4C9" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="2" Margin="0,7,12,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{StaticResource Accent}" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EpgEmpty" Grid.Row="1" Text="Bir kanal seçerek program rehberini görüntüleyin.&#xA;Geçmiş programı çift tıklayarak tekrar izleyin.*" Foreground="#7F8FA5" FontSize="11" LineHeight="22" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="BottomBar" Grid.Row="4" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="●  Hazır · İçerik sağlanmaz. Kendi kaynağınızı ekleyin." Foreground="#8494A8" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="85" Height="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0" />
        <Button x:Name="CancelButton" Grid.Column="2" Content="İptal" Click="Cancel_Click" Visibility="Collapsed" FontSize="10" Padding="10,3" />
      </Grid>
    </Grid>
  </Grid>
</Window>