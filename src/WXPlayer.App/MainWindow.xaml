<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WXPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WX Player" Width="1440" Height="920" MinWidth="900" MinHeight="650" Style="{StaticResource AppWindow}" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged" Closing="Window_Closing" xmlns:ui="clr-namespace:WXPlayer.App" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <!-- Explicit shell styles do not affect media pages, dialogs or player controls. -->
    <Style x:Key="ShellButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="MinHeight" Value="{StaticResource ControlHeightProminent}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ShellChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ShellChrome" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ShellChrome" Property="Opacity" Value="0.72"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ShellChrome" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ShellPrimaryButton" TargetType="Button" BasedOn="{StaticResource ShellButton}">
      <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource BackgroundBaseBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource ButtonTextFontSize}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <DataTemplate x:Key="FullscreenContentTemplate">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="8"><ui:ChannelLogo Url="{Binding Logo}" Initials="{Binding Initials}"/></Border>
        <StackPanel Grid.Column="1" Margin="11,0,7,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding KindLabel}" FontSize="9" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,6,0,0"/></StackPanel>
        <Button Grid.Column="2" MinWidth="36" MinHeight="36" Tag="{Binding}" PreviewMouseLeftButtonDown="Favorite_PreviewMouseDown" Click="Favorite_Click" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="Favori"><ui:SvgIcon Icon="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}" Width="17" Height="17" Foreground="{StaticResource AccentPrimaryBrush}"/></Button>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="Root" Background="{StaticResource BackgroundBaseBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="76" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="{StaticResource BackgroundSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" CornerRadius="0" Margin="0" Padding="10,24,10,16" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="5,0,0,24">
            <Button x:Name="BrandToggle" Click="SidebarToggle_Click" Style="{StaticResource ShellButton}" Width="42" Height="42" Padding="0" ToolTip="Menüyü daralt / genişlet">
              <Grid><TextBlock x:Name="BrandMark" Text="W" FontWeight="Black" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /><ui:SvgIcon x:Name="DrawerClose" Icon="chevron-left" Width="20" Height="20" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/></Grid>
            </Button>
            <StackPanel x:Name="BrandWordmark" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WX Player" FontSize="{StaticResource SectionTitleFontSize}" FontWeight="Bold" />
              <TextBlock Text="İZLEME ALANINIZ" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="NavLabel" Text="KÜTÜPHANE" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource MetadataFontSize}" FontWeight="SemiBold" Margin="12,0,0,8" />
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Tag="home" Click="Navigate_Click">
            <ui:IconLabel Icon="home" Label="Ana sayfa" />
          </Button>
          <Button x:Name="LiveNav" Style="{StaticResource Nav}" Tag="live" Click="Navigate_Click">
            <ui:IconLabel Icon="tv" Label="Canlı TV" />
          </Button>
          <Button x:Name="MovieNav" Style="{StaticResource Nav}" Tag="movie" Click="Navigate_Click">
            <ui:IconLabel Icon="film" Label="Filmler" />
          </Button>
          <Button x:Name="SeriesNav" Style="{StaticResource Nav}" Tag="series" Click="Navigate_Click">
            <ui:IconLabel Icon="series" Label="Diziler" />
          </Button>
          <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="12,16" />
          <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Tag="favorites" Click="Navigate_Click">
            <ui:IconLabel Icon="star" Label="Favorilerim" />
          </Button>
          <Button x:Name="EpgNav" Style="{StaticResource Nav}" Tag="epg" Click="Navigate_Click">
            <ui:IconLabel Icon="epg" Label="Program rehberi" />
          </Button>
          <Button x:Name="RecentNav" Style="{StaticResource Nav}" Tag="recent" Click="Navigate_Click">
            <ui:IconLabel Icon="history" Label="Son izlenenler" />
          </Button>
          <Button x:Name="RecordingsNav" Style="{StaticResource Nav}" Click="Recordings_Click">
            <ui:IconLabel Icon="recordings" Label="Kayıtlarım" />
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="PromoCard" Background="{StaticResource SurfaceBrush}" BorderThickness="0" CornerRadius="{StaticResource RadiusLarge}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="KÜTÜPHANE ÖZETİ" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,12" />
              <Grid x:Name="StatsBar">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock x:Name="LiveCount" Text="0" FontSize="{StaticResource SectionTitleFontSize}" FontWeight="SemiBold" />
                  <TextBlock Text="Canlı kanal" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="MovieCount" Text="0" FontSize="{StaticResource SectionTitleFontSize}" FontWeight="SemiBold" />
                  <TextBlock Text="Film" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                  <TextBlock x:Name="SeriesCount" Text="0" FontSize="{StaticResource SectionTitleFontSize}" FontWeight="SemiBold" />
                  <TextBlock Text="Dizi" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBlock x:Name="FavoriteCount" Text="0" FontSize="{StaticResource SectionTitleFontSize}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                  <TextBlock Text="Favori" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click">
            <ui:IconLabel Icon="settings" Label="Ayarlar" />
          </Button>
      <TextBlock x:Name="VersionLabel" Text="WX PLAYER  /  1.7.0" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="12,12,0,0" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="MainArea" Margin="32,26,32,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="TopBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel><Button x:Name="SidebarToggle" Click="SidebarToggle_Click" Style="{StaticResource ShellButton}" Padding="10" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="Menüyü daralt / genişlet · Ctrl+B"><ui:SvgIcon Icon="panel-left" /></Button><StackPanel>
          <TextBlock Text="İYİ SEYİRLER" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource MetadataFontSize}" FontWeight="SemiBold" />
          <TextBlock x:Name="PageTitle" Text="Ana sayfa" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel></DockPanel>
        <ComboBox x:Name="SourcePicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Source_Changed" ToolTip="Aktif kaynak" AutomationProperties.Name="Aktif kaynak" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Style="{StaticResource ShellButton}" Click="Summary_Click" ToolTip="Kütüphane özeti" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="library" />
          </Button>
          <Button Style="{StaticResource ShellButton}" Click="Refresh_Click" ToolTip="Kaynağı yenile" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="refresh" />
          </Button>
          <Button Style="{StaticResource ShellButton}" Click="ManageSource_Click" ToolTip="Kaynak seçenekleri" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="more" />
          </Button>
          <Button x:Name="AddSourceButton" Style="{StaticResource ShellPrimaryButton}" Click="AddSource_Click" VerticalAlignment="Center" Margin="0">
            <ui:IconLabel Icon="plus" Label="Kaynak ekle" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="ContentGrid" Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="355" />
          <ColumnDefinition x:Name="GapColumn" Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="LibraryPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="3" Background="{StaticResource BackgroundSecondaryBrush}" CornerRadius="{StaticResource RadiusLarge}" />
          <ListBox x:Name="ChannelList" Grid.Row="1" SelectionChanged="Channel_Selected" MouseDoubleClick="Channel_DoubleClick" AutomationProperties.Name="İçerik listesi" Margin="8,0,8,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="{StaticResource RadiusMedium}" Width="42" Height="42">
                    <ui:ChannelLogo Url="{Binding Logo}" Initials="{Binding Initials}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="9" Margin="0,1,7,0" />
                      <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressLabel}" />
                  </StackPanel>
                  <Button Grid.Column="2" MinWidth="36" MinHeight="36" Tag="{Binding}" PreviewMouseLeftButtonDown="Favorite_PreviewMouseDown" Click="Favorite_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="20" Padding="0" ToolTip="Favoriyi değiştir" AutomationProperties.Name="Favoriyi değiştir">
                    <ui:SvgIcon Icon="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyList" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="265">
            <ui:SvgIcon Icon="series" Width="21" Height="21" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="İlk kaynağınızı ekleyin" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,8" />
            <TextBlock x:Name="EmptyDescription" Text="M3U, Xtream veya Stalker ile tüm içeriklerinize tek yerden ulaşın." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
            <Button x:Name="DemoButton" Click="Demo_Click" Margin="0,20,0,0" Background="Transparent" Foreground="{StaticResource Accent}">
              <ui:IconLabel Icon="arrow-right" Label="Örnek yayınları keşfet" />
            </Button>
          </StackPanel>
          <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <Button x:Name="PrevPage" DockPanel.Dock="Left" Click="PrevPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-left" />
            </Button>
            <Button x:Name="NextPage" DockPanel.Dock="Right" Click="NextPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-right" />
            </Button>
            <TextBlock x:Name="PageLabel" Text="0 içerik" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
          </DockPanel>
          <StackPanel x:Name="FilterBar" Margin="16,18,16,12">
            <DockPanel Margin="0,0,0,16">
              <TextBlock x:Name="ResultsCount" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock x:Name="ListTitle" Text="Kütüphane" FontSize="17" FontWeight="SemiBold" />
            </DockPanel>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Height="44" Padding="12,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <ui:SvgIcon Icon="search" Width="18" Height="18" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" VerticalContentAlignment="Center" CaretBrush="{StaticResource AccentPrimaryBrush}" AutomationProperties.Name="Kütüphanede ara" ToolTip="Kanal, film veya dizi ara · Ctrl+K">
                  <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                      <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center" />
                    </ControlTemplate>
                  </TextBox.Template>
                </TextBox>
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Bu kütüphanede ara…" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearSearch" Grid.Column="2" Click="ClearSearch_Click" Padding="3" Background="Transparent" BorderThickness="0" ToolTip="Aramayı temizle" Visibility="Collapsed">
                  <ui:SvgIcon Icon="close" Width="15" Height="15" />
                </Button>
              </Grid>
            </Border>
            <TextBlock Text="KATEGORİ" FontSize="9" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="1,16,0,7" />
            <ComboBox x:Name="CategoryPicker" SelectionChanged="Category_Changed" Height="42" ToolTip="İçerikleri kategoriye göre filtrele" AutomationProperties.Name="Kategori" />
          </StackPanel>
        </Grid>
        <Grid x:Name="ViewingPanel" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="GuideRow" Height="280" />
          </Grid.RowDefinitions>
          <Border x:Name="VideoBorder" CornerRadius="12,12,0,0" Background="{StaticResource BackgroundBaseBrush}" ClipToBounds="True">
            <Grid>
              <Grid x:Name="WelcomePanel" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                <StackPanel x:Name="WelcomeFull" VerticalAlignment="Center" Margin="28,24" MaxWidth="440" HorizontalAlignment="Left">
                  <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="9,5" HorizontalAlignment="Left">
                    <TextBlock Text="KÜTÜPHANENİZ" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="9" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="İzlemek istediğinizi seçin." FontSize="26" FontWeight="SemiBold" Margin="0,16,0,12" />
                  <TextBlock Text="Canlı kanallarınız, filmleriniz ve dizileriniz burada." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" LineHeight="21" />
                  <Button Style="{StaticResource Primary}" Click="AddSource_Click" HorizontalAlignment="Left" Margin="0,22,0,0">
                    <ui:IconLabel Icon="plus" Label="Kütüphaneni bağla" />
                  </Button>
                </StackPanel>
                <StackPanel x:Name="WelcomeCompact" Visibility="Collapsed" VerticalAlignment="Center" Margin="28,16" HorizontalAlignment="Left">
                  <TextBlock Text="İyi seyirler." FontSize="24" FontWeight="SemiBold" />
                  <TextBlock Text="Kütüphanenizden bir içerik seçin." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
              <ui:NativeVideoHost x:Name="Video" Visibility="Collapsed" />
            </Grid>
          </Border>
          <Border Grid.Row="1" x:Name="ControlsBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,12,12" Padding="18,14">
            <StackPanel>
              <DockPanel>
                <Button x:Name="LiveEdgeButton" DockPanel.Dock="Right" Content="● CANLI" Visibility="Collapsed" Click="GoLive_Click" Padding="10,4" Margin="8,0,0,0" FontSize="10" ToolTip="Canlı yayına dön" /><TextBlock x:Name="PlaybackBadge" DockPanel.Dock="Right" Text="HAZIR" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="NowTitle" Text="Bir içerik seçin" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ui:MediaSlider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,2" IsEnabled="False" ToolTip="Yayın konumu" Height="36" Style="{StaticResource MediaSliderStyle}" SmallChange="0.01" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Button Click="PreviousChannel_Click" ToolTip="Önceki kanal · Page Up" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-back" />
                  </Button>
                  <Button x:Name="PlayButton" Click="PlayPause_Click" ToolTip="Oynat / duraklat · Space" Padding="10,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="play" />
                  </Button>
                  <Button Click="NextChannel_Click" ToolTip="Sonraki kanal · Page Down" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-next" />
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="MuteButton" Click="Mute_Click" ToolTip="Sessiz · M" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="volume" />
                  </Button>
                  <ui:MediaSlider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center" ToolTip="Ses" Height="36" Style="{StaticResource MediaSliderStyle}" SmallChange="5" />
                  <TextBlock x:Name="VolumeLabel" Text="75" Foreground="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <Button x:Name="FitButton" Click="Fit_Click" ToolTip="Görüntü: sığdır / ekranı doldur · Z" Padding="9,5" Background="Transparent" BorderThickness="0">
                    <ui:SvgIcon Icon="fill" />
                  </Button>
                  <Button x:Name="RecordButton" Foreground="#FF8C91" Click="Record_Click" ToolTip="Kaydı başlat / bitir" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="record" />
                  </Button>
                  <Button Click="Statistics_Click" ToolTip="Yayın istatistikleri · I" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <ui:SvgIcon Icon="statistics" />
                  </Button>
                  <Button Click="Tracks_Click" ToolTip="Ses ve altyazı parçaları" FontSize="10" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="subtitles" />
                  </Button>
                  <Button Click="Fullscreen_Click" ToolTip="Tam ekran · F" FontSize="19" Padding="9,0" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="maximize" />
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="GuidePanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource RadiusLarge}" Padding="18,16" Margin="0,14,0,0">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="MatchEpg_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="EPG kanalını eşleştir"><ui:SvgIcon Icon="epg" Width="17" Height="17" /></Button><Button Click="RefreshEpg_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="Rehberi yenile"><ui:SvgIcon Icon="refresh" Width="17" Height="17" /></Button><Button Click="ExpandGuide_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="Program rehberini genişlet"><ui:SvgIcon Icon="maximize" Width="17" Height="17" /></Button></StackPanel>
<StackPanel><TextBlock Text="Yayın akışı" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="GuideTitle" Text="Bir canlı kanal seçin" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,10,0" TextTrimming="CharacterEllipsis" /></StackPanel></DockPanel>
<DockPanel Grid.Row="1" Margin="0,12,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="PreviousDay_Click" ToolTip="Önceki gün" Background="Transparent" BorderThickness="0" Padding="7,3"><ui:SvgIcon Icon="chevron-left" Width="16" Height="16" /></Button><TextBlock x:Name="GuideDate" Text="BUGÜN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0" /><Button Click="NextDay_Click" ToolTip="Sonraki gün" Background="Transparent" BorderThickness="0" Padding="7,3"><ui:SvgIcon Icon="chevron-right" Width="16" Height="16" /></Button></StackPanel><TextBlock Text="PROGRAMLAR" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
</Grid>
<ListBox x:Name="EpgList" Grid.Row="1" MouseDoubleClick="Epg_DoubleClick" AutomationProperties.Name="İzlenen kanalın yayın akışı">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,4,8" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"><ContentPresenter /></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsNow}" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" /><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentSubtleBrush}" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /><TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="9" Margin="0,5,0,0" /></StackPanel>
<StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" MaxHeight="18" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" /><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,7,0,0" /></StackPanel>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border x:Name="EpgEmptyPanel" Grid.Row="1" Background="{StaticResource SurfaceElevatedBrush}" BorderThickness="0" CornerRadius="12" Padding="18,12"><DockPanel><ui:SvgIcon Icon="epg" Width="28" Height="28" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Program rehberiniz burada" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock x:Name="EpgEmpty" Text="Bir canlı kanal seçin. Yayın akışı otomatik olarak yüklenir." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="19" TextWrapping="Wrap" /></StackPanel></DockPanel></Border>
</Grid></Border>
          <Thumb x:Name="GuideSplitter" Grid.Row="2" Height="12" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="GuideResize_DragDelta" ToolTip="Rehber yüksekliğini ayarla">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                  <Border Width="36" Height="3" CornerRadius="2" Background="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                </Grid>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Grid>
      </Grid>
      <ContentControl x:Name="HomeHost" Grid.Row="1" Margin="0,24,0,0" Visibility="Collapsed" />
      <Grid x:Name="BottomBar" Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="●  Hazır · İçerik sağlanmaz. Kendi kaynağınızı ekleyin." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="85" Height="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0" />
        <Button x:Name="CancelButton" Grid.Column="2" Content="İptal" Click="Cancel_Click" Visibility="Collapsed" FontSize="10" Padding="10,3" />
      </Grid>
    </Grid>
  </Grid>
</Window>



