<Window x:Class="WXPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="WX Player" Width="1440" Height="920" MinWidth="900" MinHeight="650" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
 <Grid x:Name="Root" Background="{StaticResource Bg}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="#10141C" BorderBrush="#242B36" BorderThickness="0,0,1,0" Padding="18,26,18,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="5,0,0,33"><Border Background="{StaticResource Accent}" CornerRadius="10" Width="42" Height="42"><TextBlock Text="W" FontWeight="Black" Foreground="#18240B" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel x:Name="BrandWordmark" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="WX Player" FontSize="20" FontWeight="Bold"/><TextBlock Text="YOUR WORLD. YOUR PLAY." FontSize="7.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <TextBlock x:Name="NavLabel" Text="KÜTÜPHANE" Foreground="#69778D" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,10"/>
     <Button x:Name="HomeNav" Style="{StaticResource Nav}" Tag="home" Click="Navigate_Click" Content="⌂    Ana sayfa"/>
     <Button x:Name="LiveNav" Style="{StaticResource Nav}" Tag="live" Click="Navigate_Click" Content="▣    Canlı TV"/>
     <Button x:Name="MovieNav" Style="{StaticResource Nav}" Tag="movie" Click="Navigate_Click" Content="▷    Filmler"/>
     <Button x:Name="SeriesNav" Style="{StaticResource Nav}" Tag="series" Click="Navigate_Click" Content="▤    Diziler"/>
     <Border Height="1" Background="#252C38" Margin="10,19"/>
     <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Tag="favorites" Click="Navigate_Click" Content="☆    Favorilerim"/>
     <Button x:Name="EpgNav" Style="{StaticResource Nav}" Tag="epg" Click="Navigate_Click" Content="▦    Program rehberi"/>
     <Button x:Name="RecentNav" Style="{StaticResource Nav}" Tag="recent" Click="Navigate_Click" Content="◷    Son izlenenler"/>
     <Button x:Name="RecordingsNav" Style="{StaticResource Nav}" Click="Recordings_Click" Content="●    Kayıtlarım"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border x:Name="PromoCard" Background="#1B261C" BorderBrush="#34432A" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,16"><StackPanel><TextBlock Text="●  Sizin kütüphaneniz" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Kendi kaynağınızı bağlayın.&#10;İzleme deneyimini siz yönetin." Foreground="#A8B79D" FontSize="10.5" LineHeight="18" Margin="0,7,0,0"/></StackPanel></Border>
     <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click" Content="⚙    Ayarlar"/>
     <TextBlock x:Name="VersionLabel" Text="WX PLAYER  /  1.0.0" FontSize="9" Foreground="#5F6D81" Margin="14,14,0,0"/>
    </StackPanel><Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" x:Name="MainArea" Margin="28,22,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="TopBar"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="İYİ SEYİRLER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Ana sayfa" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <ComboBox x:Name="SourcePicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Source_Changed" ToolTip="Aktif kaynak" AutomationProperties.Name="Aktif kaynak"/>
    <Button Grid.Column="2" x:Name="AddSourceButton" Style="{StaticResource Primary}" Content="＋  Kaynak ekle" Click="AddSource_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </Grid>
   <Grid x:Name="StatsBar" Grid.Row="1" Margin="0,24,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0"><DockPanel><TextBlock Text="▣" Foreground="{StaticResource Accent}" FontSize="22" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="LiveCount" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Canlı kanal" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Column="1" Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0"><DockPanel><TextBlock Text="▷" Foreground="#A7B5FF" FontSize="25" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="MovieCount" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Film" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Column="2" Background="#151C25" CornerRadius="10" Padding="16,12" Margin="0,0,10,0"><DockPanel><TextBlock Text="▤" Foreground="#E2B3F5" FontSize="22" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="SeriesCount" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Dizi" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Column="3" Background="#151C25" CornerRadius="10" Padding="16,12"><DockPanel><TextBlock Text="☆" Foreground="#F3D48D" FontSize="24" DockPanel.Dock="Right" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="FavoriteCount" Text="0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Favori" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
   </Grid>
   <Grid x:Name="FilterBar" Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Kanal, film, dizi veya kategori ara · Ctrl+K" AutomationProperties.Name="Kütüphanede ara" Padding="34,10,12,10"/><TextBlock Text="⌕" FontSize="22" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="Kütüphanenizde arayın…" Foreground="#76859B" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <ComboBox x:Name="CategoryPicker" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Category_Changed" ToolTip="Kategori filtresi" AutomationProperties.Name="Kategori"/>
    <Button Grid.Column="2" Content="↻" Click="Refresh_Click" ToolTip="Kaynağı yenile" FontSize="19" Margin="10,0,0,0" Padding="13,5"/>
    <Button Grid.Column="3" Content="•••" Click="ManageSource_Click" ToolTip="Kaynağı düzenle veya kaldır" Margin="8,0,0,0"/>
   </Grid>
   <Grid Grid.Row="3" x:Name="ContentGrid"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="355"/><ColumnDefinition x:Name="GapColumn" Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="LibraryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><TextBlock x:Name="ResultsCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ListTitle" Text="Kütüphaneniz" FontSize="16" FontWeight="SemiBold"/></DockPanel>
     <ListBox x:Name="ChannelList" Grid.Row="1" SelectionChanged="Channel_Selected" MouseDoubleClick="Channel_DoubleClick" AutomationProperties.Name="İçerik listesi">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border Background="#2A3442" CornerRadius="9" Width="42" Height="42"><TextBlock Text="{Binding Initials}" Foreground="#C9D6E8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,1,6,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding KindLabel}" Foreground="#A4C582" FontSize="8" Margin="0,1,7,0"/><TextBlock Text="{Binding Category}" Foreground="#8391A6" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><Button Grid.Column="2" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Click="Favorite_Click" Background="Transparent" BorderThickness="0" Foreground="#D3E7B9" FontSize="20" Padding="0" ToolTip="Favoriyi değiştir" AutomationProperties.Name="Favoriyi değiştir"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="EmptyList" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="265"><TextBlock Text="▤" FontSize="38" Foreground="#67758B" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="İlk kaynağınızı ekleyin" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,8"/><TextBlock x:Name="EmptyDescription" Text="M3U, Xtream veya Stalker ile tüm içeriklerinize tek yerden ulaşın." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/><Button x:Name="DemoButton" Content="Örnek yayınları keşfet  →" Click="Demo_Click" Margin="0,20,0,0" Background="Transparent" Foreground="{StaticResource Accent}"/></StackPanel>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="PrevPage" DockPanel.Dock="Left" Content="←" Click="PrevPage_Click" Padding="12,5"/><Button x:Name="NextPage" DockPanel.Dock="Right" Content="→" Click="NextPage_Click" Padding="12,5"/><TextBlock x:Name="PageLabel" Text="0 içerik" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
    </Grid>
    <Grid x:Name="ViewingPanel" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/><RowDefinition x:Name="GuideRow" Height="190"/></Grid.RowDefinitions>
     <Border x:Name="VideoBorder" CornerRadius="14" Background="#090C12" BorderBrush="#2A3340" BorderThickness="1" ClipToBounds="True">
      <Grid>
       <Grid x:Name="WelcomePanel" ClipToBounds="True"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C2C27"/><GradientStop Color="#121C23" Offset="0.5"/><GradientStop Color="#20243B" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="290" Height="280" Opacity="0.45"><Ellipse Width="290" Height="290" Stroke="#607D5C" StrokeThickness="1" Canvas.Left="50" Canvas.Top="-15"/><Ellipse Width="220" Height="220" Stroke="#779764" StrokeThickness="1" Canvas.Left="85" Canvas.Top="20"/><Ellipse Width="150" Height="150" Stroke="#9EBF75" StrokeThickness="1" Canvas.Left="120" Canvas.Top="55"/><Ellipse Width="82" Height="82" Fill="#537849" Canvas.Left="154" Canvas.Top="89"/><Path Data="M 0,0 L 0,35 L 28,17.5 Z" Fill="#D8F7B0" Canvas.Left="185" Canvas.Top="113"/><Ellipse Width="12" Height="12" Fill="#C4F571" Canvas.Left="88" Canvas.Top="38"/></Canvas>
        <StackPanel VerticalAlignment="Center" Margin="28,24" MaxWidth="440" HorizontalAlignment="Left"><Border Background="#273D2D" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="TAMAMEN SİZİN KONTROLÜNÜZDE" Foreground="#C3E9AA" FontSize="8" FontWeight="SemiBold"/></Border><TextBlock Text="Televizyon,&#10;sizin ritminizde." FontSize="32" FontWeight="SemiBold" Margin="0,16,0,12" LineHeight="39"/><TextBlock Text="Canlı yayınlar, sevdiğiniz filmler ve diziler.&#10;Hepsi tek, sade bir oynatıcıda." Foreground="#A4B7BB" FontSize="12" LineHeight="21"/><Button Content="＋  Kütüphaneni bağla" Style="{StaticResource Primary}" Click="AddSource_Click" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel>
       </Grid>
       <vlc:VideoView x:Name="Video" Visibility="Collapsed"><Grid Background="Transparent" MouseWheel="Video_MouseWheel" MouseLeftButtonDown="Video_Click"><Border x:Name="OverlayBadge" Background="#B00A1018" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"><TextBlock x:Name="OverlayText" Text="WX PLAYER" FontSize="10"/></Border></Grid></vlc:VideoView>
      </Grid>
     </Border>
     <Border Grid.Row="1" x:Name="ControlsBorder" Background="#171D27" CornerRadius="0,0,10,10" Padding="14,11"><StackPanel><DockPanel><TextBlock x:Name="PlaybackBadge" DockPanel.Dock="Right" Text="HAZIR" Foreground="{StaticResource Accent}" FontSize="9" VerticalAlignment="Center"/><TextBlock x:Name="NowTitle" Text="Bir içerik seçin" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" PreviewMouseLeftButtonUp="Seek_Released" Margin="0,9,0,6" IsEnabled="False" ToolTip="Yayın konumu"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="◀" Click="PreviousChannel_Click" ToolTip="Önceki kanal · Page Up" Padding="8,5" Background="Transparent" BorderThickness="0"/><Button x:Name="PlayButton" Content="▶" Click="PlayPause_Click" ToolTip="Oynat / duraklat · Space" Padding="10,5" Background="Transparent" BorderThickness="0"/><Button Content="▶|" Click="NextChannel_Click" ToolTip="Sonraki kanal · Page Down" Padding="8,5" Background="Transparent" BorderThickness="0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="MuteButton" Content="♪" Click="Mute_Click" ToolTip="Sessiz · M" Padding="8,5" Background="Transparent" BorderThickness="0"/><Slider x:Name="VolumeSlider" Width="60" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center" ToolTip="Ses"/><TextBlock x:Name="VolumeLabel" Text="75" Foreground="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="RecordButton" Content="●" Foreground="#FF8C91" Click="Record_Click" ToolTip="Kaydı başlat / bitir" Padding="9,5" Background="Transparent" BorderThickness="0"/><Button Content="CC" Click="Tracks_Click" ToolTip="Ses ve altyazı parçaları" FontSize="10" Padding="9,5" Background="Transparent" BorderThickness="0"/><Button Content="⛶" Click="Fullscreen_Click" ToolTip="Tam ekran · F" FontSize="19" Padding="9,0" Background="Transparent" BorderThickness="0"/></StackPanel></Grid></StackPanel></Border>
     <Border x:Name="GuidePanel" Grid.Row="2" Background="#141A24" CornerRadius="12" Padding="15" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Click="PreviousDay_Click" Padding="7,0" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="GuideDate" Text="BUGÜN" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0"/><Button Content="›" Click="NextDay_Click" Padding="7,0" Background="Transparent" BorderThickness="0"/><Button Content="↻" Click="RefreshEpg_Click" Padding="7,0" Background="Transparent" BorderThickness="0" ToolTip="XMLTV rehberini güncelle"/></StackPanel><TextBlock Text="Yayın akışı" FontSize="13" FontWeight="SemiBold"/></DockPanel><ListBox x:Name="EpgList" Grid.Row="1" Margin="0,9,0,0" MouseDoubleClick="Epg_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#A4B4C9" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="2" Margin="0,7,12,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{StaticResource Accent}" FontSize="8" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EpgEmpty" Grid.Row="1" Text="Bir kanal seçerek program rehberini görüntüleyin.&#10;Geçmiş programı çift tıklayarak tekrar izleyin.*" Foreground="#7F8FA5" FontSize="11" LineHeight="22" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
   </Grid>
   <Grid x:Name="BottomBar" Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="●  Hazır · İçerik sağlanmaz. Kendi kaynağınızı ekleyin." Foreground="#8494A8" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><ProgressBar x:Name="BusyBar" Grid.Column="1" Width="85" Height="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="CancelButton" Grid.Column="2" Content="İptal" Click="Cancel_Click" Visibility="Collapsed" FontSize="10" Padding="10,3"/></Grid>
  </Grid>
 </Grid>
</Window>
