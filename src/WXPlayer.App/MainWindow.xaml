              <TextBlock Text="W" FontWeight="Black" Foreground="#18240B" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="BrandWordmark" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WX Player" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="YOUR WORLD. YOUR PLAY." FontSize="8.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="NavLabel" Text="KÜTÜPHANE" Foreground="#69778D" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,10" />
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Tag="home" Click="Navigate_Click">
            <ui:IconLabel Icon="home" Label="Ana sayfa" />
          </Button>
          <Button x:Name="LiveNav" Style="{StaticResource Nav}" Tag="live" Click="Navigate_Click">
            <ui:IconLabel Icon="tv" Label="Canlı TV" />
          </Button>
          <Button x:Name="MovieNav" Style="{StaticResource Nav}" Tag="movie" Click="Navigate_Click">
            <ui:IconLabel Icon="film" Label="Filmler" />
          </Button>
          <Button x:Name="SeriesNav" Style="{StaticResource Nav}" Tag="series" Click="Navigate_Click">
            <ui:IconLabel Icon="series" Label="Diziler" />
          </Button>
          <Border Height="1" Background="#252C38" Margin="10,19" />
          <Button x:Name="FavoriteNav" Style="{StaticResource Nav}" Tag="favorites" Click="Navigate_Click">
            <ui:IconLabel Icon="star" Label="Favorilerim" />
          </Button>
          <Button x:Name="EpgNav" Style="{StaticResource Nav}" Tag="epg" Click="Navigate_Click">
            <ui:IconLabel Icon="epg" Label="Program rehberi" />
          </Button>
          <Button x:Name="RecentNav" Style="{StaticResource Nav}" Tag="recent" Click="Navigate_Click">
            <ui:IconLabel Icon="history" Label="Son izlenenler" />
          </Button>
          <Button x:Name="RecordingsNav" Style="{StaticResource Nav}" Click="Recordings_Click">
            <ui:IconLabel Icon="recordings" Label="Kayıtlarım" />
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="PromoCard" Background="#151D22" BorderBrush="#34432A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="KÜTÜPHANE ÖZETİ" Foreground="#8C9D93" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,12" />
              <Grid x:Name="StatsBar">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock x:Name="LiveCount" Text="0" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Canlı kanal" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="MovieCount" Text="0" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Film" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                  <TextBlock x:Name="SeriesCount" Text="0" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Dizi" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBlock x:Name="FavoriteCount" Text="0" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                  <TextBlock Text="Favori" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="Settings_Click">
            <ui:IconLabel Icon="settings" Label="Ayarlar" />
          </Button>
          <TextBlock x:Name="VersionLabel" Text="WX PLAYER  /  1.3.0" FontSize="9" Foreground="#5F6D81" Margin="14,14,0,0" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" x:Name="MainArea" Margin="28,22,28,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="TopBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="İYİ SEYİRLER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock x:Name="PageTitle" Text="Ana sayfa" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <ComboBox x:Name="SourcePicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Source_Changed" ToolTip="Aktif kaynak" AutomationProperties.Name="Aktif kaynak" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Click="Summary_Click" ToolTip="Kütüphane özeti" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="library" />
          </Button>
          <Button Click="Refresh_Click" ToolTip="Kaynağı yenile" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="refresh" />
          </Button>
          <Button Click="ManageSource_Click" ToolTip="Kaynak seçenekleri" Padding="10" Margin="0,0,8,0">
            <ui:SvgIcon Icon="more" />
          </Button>
          <Button x:Name="AddSourceButton" Style="{StaticResource Primary}" Click="AddSource_Click" VerticalAlignment="Center" Margin="0">
            <ui:IconLabel Icon="plus" Label="Kaynak ekle" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="ContentGrid" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ListColumn" Width="355" />
          <ColumnDefinition x:Name="GapColumn" Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="LibraryPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="3" Background="#111821" BorderBrush="#26313D" BorderThickness="1" CornerRadius="16" />
          <ListBox x:Name="ChannelList" Grid.Row="1" SelectionChanged="Channel_Selected" MouseDoubleClick="Channel_DoubleClick" AutomationProperties.Name="İçerik listesi" Margin="8,0,8,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#2A3442" CornerRadius="9" Width="42" Height="42">
                    <TextBlock Text="{Binding Initials}" Foreground="#C9D6E8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="{Binding KindLabel}" Foreground="#A4C582" FontSize="9" Margin="0,1,7,0" />
                      <TextBlock Text="{Binding Category}" Foreground="#8391A6" FontSize="10" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Tag="{Binding}" Click="Favorite_Click" Background="Transparent" BorderThickness="0" Foreground="#D3E7B9" FontSize="20" Padding="0" ToolTip="Favoriyi değiştir" AutomationProperties.Name="Favoriyi değiştir">
                    <ui:SvgIcon Icon="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyList" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="265">
            <ui:SvgIcon Icon="series" Width="21" Height="21" Foreground="#67758B" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="İlk kaynağınızı ekleyin" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,8" />
            <TextBlock x:Name="EmptyDescription" Text="M3U, Xtream veya Stalker ile tüm içeriklerinize tek yerden ulaşın." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
            <Button x:Name="DemoButton" Click="Demo_Click" Margin="0,20,0,0" Background="Transparent" Foreground="{StaticResource Accent}">
              <ui:IconLabel Icon="arrow-right" Label="Örnek yayınları keşfet" />
            </Button>
          </StackPanel>
          <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <Button x:Name="PrevPage" DockPanel.Dock="Left" Click="PrevPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-left" />
            </Button>
            <Button x:Name="NextPage" DockPanel.Dock="Right" Click="NextPage_Click" Padding="12,5" MinWidth="32" MinHeight="32">
              <ui:SvgIcon Icon="chevron-right" />
            </Button>
            <TextBlock x:Name="PageLabel" Text="0 içerik" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
          </DockPanel>
          <StackPanel x:Name="FilterBar" Margin="16,18,16,12">
            <DockPanel Margin="0,0,0,16">
              <TextBlock x:Name="ResultsCount" DockPanel.Dock="Right" Foreground="#8C9CAF" FontSize="11" VerticalAlignment="Center" />
              <TextBlock x:Name="ListTitle" Text="Kütüphane" FontSize="17" FontWeight="SemiBold" />
            </DockPanel>
            <Border Background="#0D131C" BorderBrush="#354454" BorderThickness="1" CornerRadius="10" Height="48" Padding="12,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <ui:SvgIcon Icon="search" Width="18" Height="18" Foreground="#A6B5C6" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="Search_Changed" Foreground="#F2F6FC" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" VerticalContentAlignment="Center" CaretBrush="#C1EC8B" AutomationProperties.Name="Kütüphanede ara" ToolTip="Kanal, film veya dizi ara · Ctrl+K">
                  <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                      <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center" />
                    </ControlTemplate>
                  </TextBox.Template>
                </TextBox>
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Bu kütüphanede ara…" FontSize="12" Foreground="#8596AB" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearSearch" Grid.Column="2" Click="ClearSearch_Click" Padding="3" Background="Transparent" BorderThickness="0" ToolTip="Aramayı temizle" Visibility="Collapsed">
                  <ui:SvgIcon Icon="close" Width="15" Height="15" />
                </Button>
              </Grid>
            </Border>
            <TextBlock Text="KATEGORİ" FontSize="9" Foreground="#8394A9" FontWeight="SemiBold" Margin="1,16,0,7" />
            <ComboBox x:Name="CategoryPicker" SelectionChanged="Category_Changed" Height="42" ToolTip="İçerikleri kategoriye göre filtrele" AutomationProperties.Name="Kategori" />
          </StackPanel>
        </Grid>
        <Grid x:Name="ViewingPanel" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="GuideRow" Height="280" />
          </Grid.RowDefinitions>
          <Border x:Name="VideoBorder" CornerRadius="14,14,0,0" Background="#090C12" BorderBrush="#2A3340" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Grid x:Name="WelcomePanel" ClipToBounds="True">
                <Grid.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1C2C27" />
                    <GradientStop Color="#121C23" Offset="0.5" />
                    <GradientStop Color="#20243B" Offset="1" />
                  </LinearGradientBrush>
                </Grid.Background>
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="290" Height="280" Opacity="0.45">
                  <Ellipse Width="290" Height="290" Stroke="#607D5C" StrokeThickness="1" Canvas.Left="50" Canvas.Top="-15" />
                  <Ellipse Width="220" Height="220" Stroke="#779764" StrokeThickness="1" Canvas.Left="85" Canvas.Top="20" />
                  <Ellipse Width="150" Height="150" Stroke="#9EBF75" StrokeThickness="1" Canvas.Left="120" Canvas.Top="55" />
                  <Ellipse Width="82" Height="82" Fill="#537849" Canvas.Left="154" Canvas.Top="89" />
                  <Path Data="M 0,0 L 0,35 L 28,17.5 Z" Fill="#D8F7B0" Canvas.Left="185" Canvas.Top="113" />
                  <Ellipse Width="12" Height="12" Fill="#C4F571" Canvas.Left="88" Canvas.Top="38" />
                </Canvas>
                <StackPanel x:Name="WelcomeFull" VerticalAlignment="Center" Margin="28,24" MaxWidth="440" HorizontalAlignment="Left">
                  <Border Background="#273D2D" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left">
                    <TextBlock Text="TAMAMEN SİZİN KONTROLÜNÜZDE" Foreground="#C3E9AA" FontSize="9" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="Televizyon,&#xA;sizin ritminizde." FontSize="34" FontWeight="SemiBold" Margin="0,16,0,12" LineHeight="39" />
                  <TextBlock Text="Canlı yayınlar, sevdiğiniz filmler ve diziler.&#xA;Hepsi tek, sade bir oynatıcıda." Foreground="#A4B7BB" FontSize="12" LineHeight="21" />
                  <Button Style="{StaticResource Primary}" Click="AddSource_Click" HorizontalAlignment="Left" Margin="0,22,0,0">
                    <ui:IconLabel Icon="plus" Label="Kütüphaneni bağla" />
                  </Button>
                </StackPanel>
                <StackPanel x:Name="WelcomeCompact" Visibility="Collapsed" VerticalAlignment="Center" Margin="28,16" HorizontalAlignment="Left">
                  <TextBlock Text="İyi seyirler." FontSize="24" FontWeight="SemiBold" />
                  <TextBlock Text="Kütüphanenizden bir içerik seçin." Foreground="#A4B7BB" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
              <ui:NativeVideoHost x:Name="Video" Visibility="Collapsed" />
            </Grid>
          </Border>
          <Border Grid.Row="1" x:Name="ControlsBorder" Background="#171D27" CornerRadius="0,0,14,14" Padding="18,14">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="PlaybackBadge" DockPanel.Dock="Right" Text="HAZIR" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="NowTitle" Text="Bir içerik seçin" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ui:MediaSlider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,2" IsEnabled="False" ToolTip="Yayın konumu" Height="36" Style="{StaticResource MediaSliderStyle}" SmallChange="0.01" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Button Click="PreviousChannel_Click" ToolTip="Önceki kanal · Page Up" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-back" />
                  </Button>
                  <Button x:Name="PlayButton" Click="PlayPause_Click" ToolTip="Oynat / duraklat · Space" Padding="10,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="play" />
                  </Button>
                  <Button Click="NextChannel_Click" ToolTip="Sonraki kanal · Page Down" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="skip-next" />
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="MuteButton" Click="Mute_Click" ToolTip="Sessiz · M" Padding="8,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="volume" />
                  </Button>
                  <ui:MediaSlider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_Changed" VerticalAlignment="Center" ToolTip="Ses" Height="36" Style="{StaticResource MediaSliderStyle}" SmallChange="5" />
                  <TextBlock x:Name="VolumeLabel" Text="75" Foreground="{StaticResource Muted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <Button x:Name="FitButton" Click="Fit_Click" ToolTip="Görüntü: sığdır / ekranı doldur · Z" Padding="9,5" Background="Transparent" BorderThickness="0">
                    <ui:SvgIcon Icon="fill" />
                  </Button>
                  <Button x:Name="RecordButton" Foreground="#FF8C91" Click="Record_Click" ToolTip="Kaydı başlat / bitir" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="record" />
                  </Button>
                  <Button Click="Statistics_Click" ToolTip="Yayın istatistikleri · I" Padding="8,5" Background="Transparent" BorderThickness="0">
                    <ui:SvgIcon Icon="statistics" />
                  </Button>
                  <Button Click="Tracks_Click" ToolTip="Ses ve altyazı parçaları" FontSize="10" Padding="9,5" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="subtitles" />
                  </Button>
                  <Button Click="Fullscreen_Click" ToolTip="Tam ekran · F" FontSize="19" Padding="9,0" Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="32">
                    <ui:SvgIcon Icon="maximize" />
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="GuidePanel" Grid.Row="2" Background="#111A23" CornerRadius="16" Padding="18,16" Margin="0,14,0,0" BorderBrush="#293746" BorderThickness="1">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="MatchEpg_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="EPG kanalını eşleştir"><ui:SvgIcon Icon="epg" Width="17" Height="17" /></Button><Button Click="RefreshEpg_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="Rehberi yenile"><ui:SvgIcon Icon="refresh" Width="17" Height="17" /></Button><Button Click="ExpandGuide_Click" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="Program rehberini genişlet"><ui:SvgIcon Icon="maximize" Width="17" Height="17" /></Button></StackPanel>
<StackPanel><TextBlock Text="Yayın akışı" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="GuideTitle" Text="Bir canlı kanal seçin" FontSize="11" Foreground="#91A3B9" Margin="0,4,10,0" TextTrimming="CharacterEllipsis" /></StackPanel></DockPanel>
<DockPanel Grid.Row="1" Margin="0,12,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="PreviousDay_Click" ToolTip="Önceki gün" Background="Transparent" BorderThickness="0" Padding="7,3"><ui:SvgIcon Icon="chevron-left" Width="16" Height="16" /></Button><TextBlock x:Name="GuideDate" Text="BUGÜN" Foreground="#CED8E6" FontSize="10" VerticalAlignment="Center" Margin="6,0" /><Button Click="NextDay_Click" ToolTip="Sonraki gün" Background="Transparent" BorderThickness="0" Padding="7,3"><ui:SvgIcon Icon="chevron-right" Width="16" Height="16" /></Button></StackPanel><TextBlock Text="PROGRAMLAR" Foreground="#768BA0" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
</Grid>
<ListBox x:Name="EpgList" Grid.Row="1" MouseDoubleClick="Epg_DoubleClick" AutomationProperties.Name="İzlenen kanalın yayın akışı">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,4,8" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="#18232F" BorderBrush="#263847" BorderThickness="1" CornerRadius="10" Padding="12,10"><ContentPresenter /></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsNow}" Value="True"><Setter TargetName="Row" Property="Background" Value="#203329" /><Setter TargetName="Row" Property="BorderBrush" Value="#415A3D" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#718469" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TimeLabel}" Foreground="#D3DEEB" FontSize="11" /><TextBlock Text="{Binding StateLabel}" Foreground="#A9CE8B" FontSize="9" Margin="0,5,0,0" /></StackPanel>
<StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><TextBlock Text="{Binding Description}" Foreground="#91A4B9" FontSize="11" MaxHeight="18" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" /><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,7,0,0" /></StackPanel>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border x:Name="EpgEmptyPanel" Grid.Row="1" Background="#151F2A" BorderBrush="#293847" BorderThickness="1" CornerRadius="12" Padding="18,12"><DockPanel><ui:SvgIcon Icon="epg" Width="28" Height="28" Foreground="#809B8A" Margin="0,0,14,0" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Program rehberiniz burada" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock x:Name="EpgEmpty" Text="Bir canlı kanal seçin. Yayın akışı otomatik olarak yüklenir." Foreground="#A3B2C4" FontSize="12" LineHeight="19" TextWrapping="Wrap" /></StackPanel></DockPanel></Border>
</Grid></Border>
          <Thumb x:Name="GuideSplitter" Grid.Row="2" Height="12" VerticalAlignment="Top" Cursor="SizeNS" DragDelta="GuideResize_DragDelta" ToolTip="Rehber yüksekliğini ayarla">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                  <Border Width="36" Height="3" CornerRadius="2" Background="#3B4B5C" VerticalAlignment="Center" />
                </Grid>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Grid>
      </Grid>
      <Grid x:Name="BottomBar" Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="●  Hazır · İçerik sağlanmaz. Kendi kaynağınızı ekleyin." Foreground="#8494A8" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="85" Height="3" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0" />
        <Button x:Name="CancelButton" Grid.Column="2" Content="İptal" Click="Cancel_Click" Visibility="Collapsed" FontSize="10" Padding="10,3" />
      </Grid>
    </Grid>
  </Grid>
</Window>
